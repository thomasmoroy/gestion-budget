# Chaîne de connexion PostgreSQL Supabase (Dashboard → Settings → Database → Connection string → URI)
# Exemple : postgresql://postgres:PASSWORD@db.XXXXX.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Projets Supabase (Dashboard → Settings → API)
SUPABASE_URL=https://XXXXX.supabase.co
SUPABASE_ANON_KEY=

# Port de l'API
PORT=3001
